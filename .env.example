# Brevo Transactional Email Configuration for Vercel
# Add these in Vercel Project Settings -> Environment Variables

# Required: Your Brevo SMTP API Key
BREVO_API_KEY=xkeysib-your-brevo-key-here

# Primary Inbox (Sends as TO):
LEAD_RECIPIENT_EMAIL=sudeep.sangamam@gmail.com

# Secondary Inbox (Sends as CC):
LEAD_CC_EMAIL=solutions.policycare@gmail.com

# Optional custom sender:
BREVO_SENDER_EMAIL=no-reply@policycaresolutions.com
